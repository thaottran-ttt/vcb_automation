      <name>username</name>
   </variable>
   <variable>
      <defaultValue>'oxhWAdmPKdsI6woWWukVxg=='</defaultValue>
      <description>M2U password (encrypted)</description>
      <id>aa000001-0000-0000-0000-000000000002</id>
      <masked>true</masked>
      <name>password</name>
   </variable>
   <variable>
      <defaultValue>'931206137634'</defaultValue>
      <description>IC number for NRIC customers; passport number for Passport customers</description>
      <id>aa000001-0000-0000-0000-000000000003</id>
      <masked>false</masked>
      <name>idNumber</name>
   </variable>
   <variable>
      <defaultValue>'MyKad'</defaultValue>
      <description>ID type used for login context — 'MyKad' or 'Passport'</description>
      <id>aa000001-0000-0000-0000-000000000004</id>
      <masked>false</masked>
      <name>idType</name>
   </variable>
   <variable>
      <defaultValue>'0000007001853661'</defaultValue>
      <description>Card PAN for Secure2u login</description>
      <id>aa000001-0000-0000-0000-000000000005</id>
      <masked>false</masked>
      <name>PAN</name>
   </variable>
   <variable>
      <defaultValue>'ACCOUNTS'</defaultValue>
      <description>Tab to select on the Apply page (e.g. 'ACCOUNTS', 'CARDS')</description>
      <id>aa000001-0000-0000-0000-000000000006</id>
      <masked>false</masked>
      <name>tabName</name>
   </variable>
   <variable>
      <defaultValue>'Kawanku Savings Account'</defaultValue>
      <description>Product name — determines conditional logic for Zest-i flow</description>
      <id>aa000001-0000-0000-0000-000000000007</id>
      <masked>false</masked>
      <name>accountType</name>
   </variable>
   <variable>
      <defaultValue>['Savings Account', 'Kawanku Savings Account', 'Split-tiered interest rates, calculated daily and credited half-yearly in June and December', 'Various account management options: over the counter, ATM and Debit Card, Vcb2u.com and M2U Mobile']</defaultValue>
      <description>Labels verified on the product info screen (before Apply Now)</description>
      <id>aa000001-0000-0000-0000-000000000008</id>
      <masked>false</masked>
      <name>fistVerifyData</name>
   </variable>
   <variable>
      <defaultValue>[]</defaultValue>
      <description>SA question labels — used with saType='standard' only</description>
      <id>aa000001-0000-0000-0000-000000000010</id>
      <masked>false</masked>
      <name>questionList</name>
   </variable>
   <variable>
      <defaultValue>[:]</defaultValue>
      <description>SA dropdown answers Map — used with saType='standard' or 'new'</description>
      <id>aa000001-0000-0000-0000-000000000011</id>
      <masked>false</masked>
      <name>inputDrpData</name>
   </variable>
   <variable>
      <defaultValue>''</defaultValue>
      <description>SA option string — used with saType='new' (PBA, PBAi)</description>
      <id>aa000001-0000-0000-0000-000000000012</id>
      <masked>false</masked>
      <name>option</name>
   </variable>
   <variable>
      <defaultValue>'Next'</defaultValue>
      <description>SA submit button text</description>
      <id>aa000001-0000-0000-0000-000000000013</id>
      <masked>false</masked>
      <name>btnText</name>
   </variable>
   <variable>
      <defaultValue>['Kawanku Savings Account Application', 'To speed up your application, we\'ve pre-filled some info for you. Kindly edit as you see fit.']</defaultValue>
      <description>UI labels to verify on Step 1 screen</description>
      <id>aa000001-0000-0000-0000-000000000014</id>
      <masked>false</masked>
      <name>stepOneUIData</name>
   </variable>
   <variable>
      <defaultValue>[('Address line 1') : 'add1', ('Address line 2') : 'add2']</defaultValue>
      <description>Step-1 text inputs Map — Kawanku, Saving-i, G1A, Premier1.
Passport-specific keys (e.g. nationality, DOB) are supplied by the caller for Passport customers.
Leave empty [:] for PBA/PBAi (uses drpstepOneData) or Zest-i (uses personalDetails).</description>
      <id>aa000001-0000-0000-0000-000000000015</id>
      <masked>false</masked>
      <name>inputStepOneData</name>
   </variable>
   <variable>
      <defaultValue>[:]</defaultValue>
      <description>Step-1 dropdown inputs Map — Private Banking Account and Private Banking Account-i only.
When non-empty, the script also auto-generates a Malaysian mobile number for the phone field.</description>
      <id>aa000001-0000-0000-0000-000000000016</id>
      <masked>false</masked>
      <name>drpstepOneData</name>
   </variable>
   <variable>
      <defaultValue>[:]</defaultValue>
      <description>Zest-i Step-1: residential / personal details Map passed to fillResidentialInfo().
Also used for verifyZestiConfirmation() and verifyEditZestiETBConfirmation().</description>
      <id>aa000001-0000-0000-0000-000000000017</id>
      <masked>false</masked>
      <name>personalDetails</name>
   </variable>
   <variable>
      <defaultValue>['Kawanku Savings Account Application', 'Please fill in your employment details']</defaultValue>
      <description>UI labels to verify on Step 2 screen</description>
      <id>aa000001-0000-0000-0000-000000000018</id>
      <masked>false</masked>
      <name>stepTwoUIData</name>
   </variable>
   <variable>
      <defaultValue>[:]</defaultValue>
      <description>Step-2 dropdown inputs Map — PMAi, Premier1, PBA, PBAi.
Leave empty [:] for Kawanku, Saving-i, G1A (verify-only step).
Zest-i uses employmentDetails instead.</description>
      <id>aa000001-0000-0000-0000-000000000019</id>
      <masked>false</masked>
      <name>drpstepTwoData</name>
   </variable>
   <variable>
      <defaultValue>[:]</defaultValue>
      <description>Zest-i Step-2: employment details Map passed to zestiNTBFillEmploymentDetail().</description>
      <id>aa000001-0000-0000-0000-000000000020</id>
      <masked>false</masked>
      <name>employmentDetails</name>
   </variable>
   <variable>
      <defaultValue>['Kawanku Savings Account Application', 'Please fill in your preferred branch\ndetails']</defaultValue>
      <description>UI labels to verify on Step 3 screen</description>
      <id>aa000001-0000-0000-0000-000000000021</id>
      <masked>false</masked>
      <name>stepThreeUIData</name>
   </variable>
   <variable>
      <defaultValue>[('State') : '', ('District') : '', ('Branch') : '']</defaultValue>
      <description>Step-3 dropdown inputs Map — branch selection or account opening purpose.
Used by all standard products. Leave empty [:] only if using Zest-i branchMap.</description>
      <id>aa000001-0000-0000-0000-000000000022</id>
      <masked>false</masked>
      <name>drpstepThreeData</name>
   </variable>
   <variable>
      <defaultValue>[:]</defaultValue>
      <description>Zest-i Step-3: branch selection Map passed to fillBranchDetail().</description>
      <id>aa000001-0000-0000-0000-000000000023</id>
      <masked>false</masked>
      <name>branchMap</name>
   </variable>
   <variable>
      <defaultValue>[:]</defaultValue>
      <description>Zest-i high-risk only: additional income details Map passed to fillAdditionalIncomeDetails().</description>
      <id>aa000001-0000-0000-0000-000000000024</id>
      <masked>false</masked>
      <name>incomeDetails</name>
   </variable>
   <variable>
      <defaultValue>false</defaultValue>
      <description>Zest-i only: true triggers fillAdditionalIncomeDetails() + extra tapNextBtn()</description>
      <id>aa000001-0000-0000-0000-000000000025</id>
      <masked>false</masked>
      <name>isHighRisk</name>
   </variable>
   <variable>
      <defaultValue>[]</defaultValue>
      <description>G1A only: debit card list for verifyCreditCardApplicationStepTwo().
Leave empty [] for all other products to skip this step.</description>
      <id>aa000001-0000-0000-0000-000000000026</id>
      <masked>false</masked>
      <name>creditCardApplicationStepTwoData</name>
   </variable>
   <variable>
      <defaultValue>''</defaultValue>
      <description>G1A only: name of the debit card to select</description>
      <id>aa000001-0000-0000-0000-000000000027</id>
      <masked>false</masked>
      <name>cardName</name>
   </variable>
   <variable>
      <defaultValue>''</defaultValue>
      <description>G1A only: T&amp;C agreement button label passed to agrreAndAcceptTnC()</description>
      <id>aa000001-0000-0000-0000-000000000028</id>
      <masked>false</masked>
      <name>agreeButton</name>
   </variable>
   <variable>
      <defaultValue>['Declaration', 'I have read and agree to be bound by the Terms and Conditions.']</defaultValue>
      <description>UI labels verified on the Declaration / Agree-and-Confirm screen</description>
      <id>aa000001-0000-0000-0000-000000000029</id>
      <masked>false</masked>
      <name>agreeAndConfirmUIData</name>
   </variable>
   <variable>
      <defaultValue>'Yes, I expressly agree to be contacted'</defaultValue>
      <description>Marketing consent radio button label</description>
      <id>aa000001-0000-0000-0000-000000000030</id>
      <masked>false</masked>
      <name>agreeRadio</name>
   </variable>
   <variable>
      <defaultValue>['Confirmation', 'Please confirm the details below', 'Personal Details', 'Employment Details']</defaultValue>
      <description>Labels verified on the first confirmation screen (verifyPMAConfirmation)</description>
      <id>aa000001-0000-0000-0000-000000000031</id>
      <masked>false</masked>
      <name>confirmUIData</name>
   </variable>
   <variable>
      <defaultValue>['Kawanku Savings Account']</defaultValue>
      <description>Labels for the second confirmation screen (verifyConfirmation).
Required for confirmStyle = 'confirm', 'confirmWithAccount', 'confirmThenWithAccount'.</description>
      <id>aa000001-0000-0000-0000-000000000032</id>
      <masked>false</masked>
      <name>confirmUISecondData</name>
   </variable>
   <variable>
      <defaultValue>'Pay Now'</defaultValue>
      <description>Button label tapped / verified on the confirmation screen to proceed</description>
      <id>aa000001-0000-0000-0000-000000000033</id>
      <masked>false</masked>
      <name>confirmNextPage</name>
   </variable>
   <variable>
      <defaultValue>'tap'</defaultValue>
      <description>Confirmation flow variant:
  'tap'                  — tap confirmNextPage only          (Kawanku, PMAi, G1A)
  'confirm'              — verifyConfirmation(data, next)    (Saving-i, Premier1)
  'confirmWithAccount'   — verifyConfirmation(data, next, acct) (PBA)
  'confirmThenWithAccount' — two verifyConfirmation calls    (PBAi)
  (Zest-i uses its own block; confirmStyle is ignored for that product)</description>
      <id>aa000001-0000-0000-0000-000000000034</id>
      <masked>false</masked>
      <name>confirmStyle</name>
   </variable>
   <variable>
      <defaultValue>''</defaultValue>
      <description>Source account name for fund transfer / account selection.
Required for: Zest-i (chooseAnotherAccount), PBA (confirmWithAccount), PBAi (confirmThenWithAccount).</description>
      <id>aa000001-0000-0000-0000-000000000035</id>
      <masked>false</masked>
      <name>accountName</name>
   </variable>
   <variable>
      <defaultValue>[:]</defaultValue>
      <description>Zest-i only: edited additional details Map for verifyEditZestiETBConfirmation()</description>
      <id>aa000001-0000-0000-0000-000000000036</id>
      <masked>false</masked>
      <name>edittedAdditionalDetails</name>
   </variable>
   <variable>
      <defaultValue>'Reject'</defaultValue>
      <description>S2U authorization outcome: 'Approve' or 'Reject'</description>
      <id>aa000001-0000-0000-0000-000000000037</id>
      <masked>false</masked>
      <name>s2uStatus</name>
   </variable>
   <variable>
      <defaultValue>['Authorisation failed']</defaultValue>
      <description>Expected title on the status screen after S2U</description>
      <id>aa000001-0000-0000-0000-000000000038</id>
      <masked>false</masked>
      <name>statusScreenTitle</name>
   </variable>
   <variable>
      <defaultValue>['Your Secure Verification authorisation was rejected.']</defaultValue>
      <description>Expected description on the status screen after S2U</description>
      <id>aa000001-0000-0000-0000-000000000039</id>
      <masked>false</masked>
      <name>statusScreenDescription</name>
   </variable>
