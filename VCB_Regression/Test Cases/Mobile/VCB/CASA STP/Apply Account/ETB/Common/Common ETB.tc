<?xml version="1.0" encoding="UTF-8"?>
<TestCaseEntity>
   <description>Unified ETB common test case for NRIC and Passport flows. Supports:
Kawanku Savings Account, Saving-i, Global Access Account-i, Premier 1 Account,
PMAi, Private Banking Account, Private Banking Account-i, Zest-i.
Pass idType = 'MyKad' for NRIC customers; 'Passport' for Passport customers.
The idNumber parameter accepts IC numbers (NRIC) or passport numbers accordingly.</description>
   <name>Common ETB</name>
   <tag></tag>
   <comment></comment>
   <recordOption>OTHER</recordOption>
